{
  "name": "foosball-react-nodejs",
  "version": "1.0.0",
  "description": "Foosball Ranking System in React/NodeJS",
  "main": "server/server.js",
  "scripts": {
    "start": "NODE_ENV=production node server/server.js",
    "dev:server": "nodemon server/server.js",
    "dev:client": "PORT=8080 react-scripts start",
    "build": "react-scripts build",
    "test": "node --test server/test/*.test.js"
  },
  "author": "Andy Wong",
  "license": "MIT",
  "proxy": "http://localhost:3000/",
  "dependencies": {
    "better-sqlite3": "^11.10.0",
    "body-parser": "^1.18.2",
    "elo-rank": "^1.0.3",
    "express": "^4.16.3",
    "react": "^16.3.2",
    "react-dom": "^16.3.2",
    "react-scripts": "^5.0.0",
    "uuid": "^11.1.1"
  },
  "devDependencies": {
    "nodemon": "^1.17.4",
    "supertest": "^7.0.0"
  },
  "overrides": {
    "uuid": "^11.1.1",
    "request": {
      "form-data": "2.5.6"
    }
  }
}
